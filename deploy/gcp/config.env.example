# Copy to config.env and fill in. Non-secret values only.
PROJECT_ID=your-gcp-project-id
# Cloud Run domain mappings are not available in Seoul (asia-northeast3).
REGION=asia-northeast1
SERVICE=kmatap
AR_REPO=kmatap
SQL_INSTANCE=kmatap-db
DB_NAME=tap
DB_USER=tap
# Subdomain the KMA IT team will point at Cloud Run (CNAME ghs.googlehosted.com).
DOMAIN=tap.kma.or.kr
MIN_INSTANCES=1
MAX_INSTANCES=3
