# GitHub에 실제 secrets.toml을 커밋하지 마세요.
APP_MODE = "demo"

# 합성 테스트 데이터만 저장하는 GitHub 테스트 저장소입니다.
# 실제 이름·사번·이메일·개인정보는 입력하지 마세요.
[github_demo_store]
enabled = false
repository = "skytree96-cmyk/KMA_TAB_v2"
branch = "demo-data"
token = "github_pat_replace_me"
participant_hash_salt = "replace-with-a-long-random-value"
access_code = "replace-with-a-shared-planning-test-code"

# 실제 회원사 운영 전 외부 PostgreSQL과 인증 설정을 연결하세요.
# DATABASE_URL = "postgresql://user:password@host:5432/database"
# ADMIN_PASSWORD_HASH = "$2b$..."
# TOKEN_PEPPER = "replace-with-a-long-random-secret"
